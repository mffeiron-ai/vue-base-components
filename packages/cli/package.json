{
  "name": "@rionstudio/cli",
  "version": "0.1.0",
  "description": "RionStudio CLI - 将 UI 组件复制到你的项目（Registry 源码分发）",
  "type": "module",
  "bin": {
    "rionstudio": "./index.mjs"
  },
  "publishConfig": {
