{
	// 注意：本机 PowerShell 禁止执行 npm.ps1，所以统一用 `cmd /c npm ...` 调用
	"version": "2.0.0",
	"tasks": [
		{
			"label": "dev · 文档站 (app → http://localhost:5174)",
			"type": "shell",
			"command": "cmd /c npm run dev",
			"isBackground": true,
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			}
		},
		{
			"label": "build · 文档站（产物 app/dist）",
			"type": "shell",
			"command": "cmd /c npm run build",
			"problemMatcher": [],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "preview · 预览构建产物",
			"type": "shell",
			"command": "cmd /c npm run preview",
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "registry · 重建组件注册表",
			"type": "shell",
			"command": "cmd /c npm run registry:build",
			"problemMatcher": []
		},
		{
			"label": "docs:dev · VitePress（历史遗留）",
			"type": "shell",
			"command": "cmd /c npm run docs:dev",
			"isBackground": true,
			"problemMatcher": []
		}
	]
}
